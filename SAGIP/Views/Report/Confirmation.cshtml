@model ReportConfirmationViewModel
@{
    ViewData["Title"] = "Report Submitted Safely";
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 space-y-6">
    <div class="bg-white border border-[#DCE2D8] rounded-2xl p-6 sm:p-10 space-y-6">
        <div class="space-y-2">
            <div class="w-10 h-10 rounded-full bg-[#EAF0E8] text-[#214A35] flex items-center justify-center mb-2">
                <i data-lucide="check" class="w-5 h-5"></i>
            </div>
            <p class="text-xs font-semibold uppercase tracking-wider text-[#2F6347]">
                Submission received
            </p>
            <h1 class="font-serif text-3xl font-semibold text-[#16211A]">
                Report submitted safely.
            </h1>
            <p class="text-sm text-[#45544B] leading-relaxed">
                Keep your reference code. You will need it to check status. A lost code cannot be recovered.
            </p>
        </div>

        <!-- Reference Code Display -->
        <div class="bg-[#F6F4EC] border border-[#DCE2D8] rounded-xl p-5 space-y-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-[#66756B]">
                Your reference code
            </span>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <span id="refCodeText" class="font-mono text-xl sm:text-3xl font-semibold text-[#1B3B2B] tracking-wider select-all break-all">
                    @Model.ReferenceCode
                </span>
                <button type="button" onclick="copyRefCode()" class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#DCE2D8] bg-white hover:bg-[#EAF0E8] text-xs font-semibold text-[#1B3B2B] transition-colors cursor-pointer shrink-0">
                    <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                    <span id="copyBtnText">Copy</span>
                </button>
            </div>
        </div>

        <!-- Pathway and Receiving Office Info -->
        <div class="bg-[#EAF0E8] border border-[#C9D6C5] rounded-xl p-4 text-xs text-[#214A35] space-y-1">
            <p class="font-semibold">Receiving office: @Model.ReceivingOffice</p>
            <p class="text-[#45544B]">
                @(Model.IsRA9262Pathway
                    ? "This report will be reviewed under Republic Act 9262 by authorized barangay VAWC officers."
                    : "This report has been logged and will be processed for referral to appropriate social welfare or legal services.")
            </p>
        </div>

        <div class="bg-[#FBF1EC] border border-[#E6C8BC] rounded-xl p-4 text-xs text-[#8A3422] space-y-1">
            <p class="font-semibold">Important reminder</p>
            <p>
                Avoid saving this code in shared cloud notes or group chats if someone else has access to your phone or computer.
            </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
            <a asp-controller="Status" asp-action="Index" asp-route-code="@Model.ReferenceCode" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-[#214A35] hover:bg-[#183828] text-white text-sm font-semibold transition-colors cursor-pointer text-center">
                <span>Check report status</span>
                <i data-lucide="arrow-right" class="w-4 h-4 shrink-0"></i>
            </a>
            <a asp-controller="Home" asp-action="Index" class="w-full sm:w-auto px-4 py-2.5 rounded-lg border border-[#DCE2D8] text-[#45544B] hover:text-[#16211A] hover:bg-[#F6F4EC] text-sm font-semibold transition-colors text-center">
                Return to home
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function copyRefCode() {
        const text = document.getElementById('refCodeText').innerText.trim();
        navigator.clipboard.writeText(text).then(() => {
            const btn = document.getElementById('copyBtnText');
            btn.textContent = 'Copied!';
            setTimeout(() => { btn.textContent = 'Copy'; }, 2500);
        });
    }
</script>
}
