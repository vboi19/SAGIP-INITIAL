@model StatusLookupViewModel
@{
    ViewData["Title"] = "Check Status";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-10 space-y-6">
    <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#45544B] hover:text-[#1B3B2B] cursor-pointer">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
        <span>Back to home</span>
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left Lookup Form -->
        <div class="lg:col-span-5 bg-white border border-[#DCE2D8] rounded-2xl p-6 space-y-5">
            <div class="space-y-1.5">
                <p class="text-xs font-semibold uppercase tracking-wider text-[#2F6347]">
                    Check status
                </p>
                <h1 class="font-serif text-3xl font-semibold text-[#16211A]">
                    Enter your reference code.
                </h1>
                <p class="text-xs text-[#66756B] leading-relaxed">
                    Only the current status and receiving office are shown here. Case details are never displayed.
                </p>
            </div>

            <form asp-action="Lookup" method="post" class="space-y-3">
                @Html.AntiForgeryToken()
                <div>
                    <label for="ref-code-input" class="block text-xs font-semibold text-[#16211A] mb-1">
                        Reference code
                    </label>
                    <input id="ref-code-input" type="text" asp-for="ReferenceCode" placeholder="e.g. K7QM-4XD2-9WTR" class="w-full px-3.5 py-2.5 rounded-lg border border-[#DCE2D8] bg-white font-mono text-sm uppercase tracking-wider focus:outline-none" required />
                </div>

                <button type="submit" class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg bg-[#214A35] hover:bg-[#183828] text-white text-sm font-semibold transition-colors cursor-pointer">
                    <span>Check status</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </form>

            <div class="pt-2 border-t border-[#DCE2D8] text-xs text-[#66756B] space-y-1">
                <p>Sample codes to try:</p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" onclick="fillCode('K7QM-4XD2-9WTR')" class="font-mono text-[11px] text-[#214A35] underline underline-offset-2 cursor-pointer">K7QM-4XD2-9WTR</button>
                    <button type="button" onclick="fillCode('A9BC-71KL-22MN')" class="font-mono text-[11px] text-[#214A35] underline underline-offset-2 cursor-pointer">A9BC-71KL-22MN</button>
                    <button type="button" onclick="fillCode('Z5VB-77NM-19QW')" class="font-mono text-[11px] text-[#214A35] underline underline-offset-2 cursor-pointer">Z5VB-77NM-19QW</button>
                </div>
            </div>
        </div>

        <!-- Right Status Display -->
        <div class="lg:col-span-7 space-y-4">
            @if (Model.Searched && Model.Found)
            {
                var status = Model.Status ?? "Received";
                <div class="bg-white border border-[#DCE2D8] rounded-2xl p-6 sm:p-8 space-y-6">
                    <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-[#DCE2D8] pb-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <p class="text-xs font-mono text-[#66756B] uppercase tracking-wider">Report</p>
                                <button type="button" onclick="toggleStatusPrivacy()" id="statusVeilBtn" title="Mask reference code for shoulder-surfing privacy" class="inline-flex items-center gap-1 text-[11px] font-mono text-[#2F6347] hover:underline cursor-pointer">
                                    <i data-lucide="eye" id="statusVeilIcon" class="w-3 h-3"></i>
                                    <span id="statusVeilText">Hide</span>
                                </button>
                            </div>
                            <p id="statusCodeDisplay" class="font-mono text-xl sm:text-2xl font-semibold text-[#1B3B2B] tracking-wide mt-0.5 break-all transition-all duration-300 select-all">
                                @Model.ReferenceCode
                            </p>
                        </div>
                        <div class="text-left sm:text-right">
                            <p class="text-xs text-[#66756B]">Receiving office</p>
                            <p class="text-sm font-semibold text-[#16211A] mt-0.5">@Model.ReceivingOffice</p>
                        </div>
                    </div>

                    <!-- Progress Stepper with Ambient Active Pulse -->
                    <div class="space-y-2">
                        <p class="text-xs font-semibold uppercase tracking-wider text-[#2F6347]">Current progress</p>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
                            <!-- Received -->
                            <div class="p-3 rounded-xl border text-xs transition-all duration-300 @(status == "Received" ? "bg-[#1B3B2B] border-[#1B3B2B] text-white font-semibold ring-1 ring-emerald-500/30 shadow-xs" : status != "Received" ? "bg-[#EAF0E8] border-[#C9D6C5] text-[#214A35] font-medium" : "bg-[#F6F4EC] border-[#DCE2D8] text-[#66756B]")">
                                <div class="flex items-center gap-1.5 mb-1">
                                    @if (status != "Received") { 
                                        <i data-lucide="check" class="w-3.5 h-3.5"></i> 
                                    } else { 
                                        <span class="status-dot-pulse w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span> 
                                    }
                                    <span>Received</span>
                                </div>
                            </div>

                            <!-- Under Assessment -->
                            <div class="p-3 rounded-xl border text-xs transition-all duration-300 @(status == "Under Assessment" ? "bg-[#1B3B2B] border-[#1B3B2B] text-white font-semibold ring-1 ring-emerald-500/30 shadow-xs" : (status == "Referred" || status == "BPO Issued" || status == "Closed") ? "bg-[#EAF0E8] border-[#C9D6C5] text-[#214A35] font-medium" : "bg-[#F6F4EC] border-[#DCE2D8] text-[#66756B]")">
                                <div class="flex items-center gap-1.5 mb-1">
                                    @if (status == "Referred" || status == "BPO Issued" || status == "Closed") { 
                                        <i data-lucide="check" class="w-3.5 h-3.5"></i> 
                                    } else if (status == "Under Assessment") { 
                                        <span class="status-dot-pulse w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span> 
                                    } else { 
                                        <span class="font-mono text-[10px]">○</span> 
                                    }
                                    <span>Under Assessment</span>
                                </div>
                            </div>

                            <!-- Referred / BPO Issued -->
                            <div class="p-3 rounded-xl border text-xs transition-all duration-300 @((status == "Referred" || status == "BPO Issued") ? "bg-[#1B3B2B] border-[#1B3B2B] text-white font-semibold ring-1 ring-emerald-500/30 shadow-xs" : status == "Closed" ? "bg-[#EAF0E8] border-[#C9D6C5] text-[#214A35] font-medium" : "bg-[#F6F4EC] border-[#DCE2D8] text-[#66756B]")">
                                <div class="flex items-center gap-1.5 mb-1">
                                    @if (status == "Closed") { 
                                        <i data-lucide="check" class="w-3.5 h-3.5"></i> 
                                    } else if (status == "Referred" || status == "BPO Issued") { 
                                        <span class="status-dot-pulse w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span> 
                                    } else { 
                                        <span class="font-mono text-[10px]">○</span> 
                                    }
                                    <span>Referred / BPO Issued</span>
                                </div>
                            </div>

                            <!-- Closed -->
                            <div class="p-3 rounded-xl border text-xs transition-all duration-300 @(status == "Closed" ? "bg-[#1B3B2B] border-[#1B3B2B] text-white font-semibold ring-1 ring-emerald-500/30 shadow-xs" : "bg-[#F6F4EC] border-[#DCE2D8] text-[#66756B]")">
                                <div class="flex items-center gap-1.5 mb-1">
                                    @if (status == "Closed") { 
                                        <span class="status-dot-pulse w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span> 
                                    } else { 
                                        <span class="font-mono text-[10px]">○</span> 
                                    }
                                    <span>Closed</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Consent Withdrawal Tool matching CheckStatusView.tsx -->
                    @if (Model.IsIdentified)
                    {
                        <div class="pt-4 border-t border-[#DCE2D8] space-y-3">
                            @if (Model.CanWithdrawConsent)
                            {
                                <div class="bg-[#F6F4EC] border border-[#DCE2D8] rounded-xl p-4 space-y-2">
                                    <p class="text-xs font-semibold text-[#1B3B2B]">
                                        Permission to contact is active (@Model.ContactType)
                                    </p>
                                    <p class="text-xs text-[#45544B] leading-relaxed">
                                        You previously agreed to be contacted by the desk officer. You may withdraw this permission at any time. If withdrawn, the desk officer will not reach out to your contact details.
                                    </p>
                                    <form asp-action="WithdrawConsent" method="post" onsubmit="return confirm('Withdraw contact consent for this report? The desk officer will no longer reach out to you.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="referenceCode" value="@Model.ReferenceCode" />
                                        <button type="submit" class="text-xs font-semibold text-[#9A3F2B] hover:text-[#8A3422] underline underline-offset-2 cursor-pointer">
                                            Withdraw contact permission
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="bg-[#EAF0E8] border border-[#C9D6C5] rounded-xl p-4 text-xs text-[#214A35]">
                                    <p class="font-semibold">Contact consent has been withdrawn.</p>
                                    <p class="text-[#45544B] mt-0.5">No further contact will happen from desk officers.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else if (Model.Searched && !Model.Found)
            {
                <div class="bg-white border border-[#E6C8BC] rounded-2xl p-6 text-sm text-[#8A3422] space-y-2">
                    <p class="font-semibold">Reference code not found</p>
                    <p class="text-xs text-[#45544B]">
                        Please double-check the 14-character code (including hyphens). Remember that lost anonymous codes cannot be recovered.
                    </p>
                </div>
            }
            else
            {
                <!-- Informational card when not searched yet -->
                <div class="bg-white border border-[#DCE2D8] rounded-2xl p-6 sm:p-8 space-y-4">
                    <h2 class="font-serif text-xl font-semibold text-[#16211A]">
                        What happens to a report
                    </h2>
                    <ul class="space-y-3 text-sm text-[#45544B]">
                        <li class="flex items-start gap-2.5">
                            <span class="font-mono text-[#2F6347] font-semibold text-xs">1.</span>
                            <span>A desk officer reviews the report narrative and verifies whether the incident is within the barangay’s service area.</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="font-mono text-[#2F6347] font-semibold text-xs">2.</span>
                            <span>For identified reports requesting a Barangay Protection Order (BPO), the officer schedules contact during your safe hours.</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                            <span class="font-mono text-[#2F6347] font-semibold text-xs">3.</span>
                            <span>If the case involves non-RA 9262 matters or an outside area, a referral is recorded and status shows Referred.</span>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillCode(c) {
        const input = document.getElementById('ref-code-input');
        if (!input) return;
        input.value = c;
        input.classList.add('ring-2', 'ring-[#214A35]', 'bg-[#EAF0E8]');
        setTimeout(() => {
            input.classList.remove('ring-2', 'ring-[#214A35]', 'bg-[#EAF0E8]');
        }, 600);
    }

    function toggleStatusPrivacy() {
        const codeEl = document.getElementById('statusCodeDisplay');
        const icon = document.getElementById('statusVeilIcon');
        const txt = document.getElementById('statusVeilText');
        if (!codeEl) return;

        const isBlurred = codeEl.style.filter === 'blur(6px)';
        if (isBlurred) {
            codeEl.style.filter = 'none';
            if (txt) txt.textContent = 'Hide';
            if (icon) icon.setAttribute('data-lucide', 'eye-off');
        } else {
            codeEl.style.filter = 'blur(6px)';
            if (txt) txt.textContent = 'Reveal';
            if (icon) icon.setAttribute('data-lucide', 'eye');
        }
        if (window.lucide) {
            lucide.createIcons();
        }
    }
</script>
}
