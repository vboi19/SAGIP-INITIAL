@{
    ViewData["Title"] = "Staff Account Setup & Enrollment";
}

<div class="max-w-md mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-[#E2DEC9] p-8 shadow-xl space-y-6">
        <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white flex items-center justify-center mx-auto mb-3 shadow-sm">
                <i data-lucide="user-plus" class="w-6 h-6"></i>
            </div>
            <h2 class="font-serif-title text-2xl font-bold text-[#16211A]">Staff Onboarding Setup</h2>
            <p class="text-xs text-[#526058] mt-1">Activate your invited SAGIP officer account</p>
        </div>

        <div class="p-3.5 rounded-xl bg-teal-50 border border-teal-200 text-xs text-teal-950">
            <p class="font-bold">Invitation Code Verified</p>
            <p class="mt-0.5">Invite Token: <code class="font-mono">@(ViewBag.Token ?? "SAGIP-INVITE-0912")</code></p>
        </div>

        <form asp-action="Login" method="get" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Create Password</label>
                <input type="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm focus:ring-2 focus:ring-[#1B4D3E] focus:outline-none" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Confirm Password</label>
                <input type="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm focus:ring-2 focus:ring-[#1B4D3E] focus:outline-none" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">MFA Enrollment (Google Authenticator / Authy)</label>
                <div class="p-3 rounded-xl bg-gray-50 border border-gray-200 text-center">
                    <div class="w-24 h-24 bg-gray-200 border border-gray-300 mx-auto flex items-center justify-center text-xs text-gray-500 font-mono">
                        [QR CODE]
                    </div>
                    <p class="text-[11px] text-gray-500 mt-2">Scan with Authenticator App</p>
                </div>
            </div>
            <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-[#1B4D3E] hover:bg-[#12352B] text-white font-semibold text-sm shadow transition-colors">
                Complete Setup & Sign In
            </button>
        </form>

        <div class="text-center pt-2">
            <a asp-action="Login" class="text-xs text-gray-500 hover:text-gray-800">Return to Sign In</a>
        </div>
    </div>
</div>
