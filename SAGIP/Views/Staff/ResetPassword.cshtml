@{
    ViewData["Title"] = "Password Reset";
}

<div class="max-w-md mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-[#E2DEC9] p-8 shadow-xl space-y-6">
        <div class="text-center">
            <div class="w-12 h-12 rounded-2xl bg-amber-500 text-white flex items-center justify-center mx-auto mb-3 shadow-sm">
                <i data-lucide="key" class="w-6 h-6"></i>
            </div>
            <h2 class="font-serif-title text-2xl font-bold text-[#16211A]">Staff Password Reset</h2>
            <p class="text-xs text-[#526058] mt-1">Reset your official barangay staff credentials</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Token as string))
        {
            <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-950">
                <p class="font-bold">Reset Token Verified</p>
                <p class="mt-0.5">Token: <code class="font-mono">@ViewBag.Token</code></p>
            </div>
            <form asp-action="Login" method="get" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">New Password</label>
                    <input type="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm focus:ring-2 focus:ring-[#1B4D3E] focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Confirm New Password</label>
                    <input type="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm focus:ring-2 focus:ring-[#1B4D3E] focus:outline-none" />
                </div>
                <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-[#1B4D3E] hover:bg-[#12352B] text-white font-semibold text-sm shadow transition-colors">
                    Save New Password & Sign In
                </button>
            </form>
        }
        else
        {
            <form asp-action="Login" method="get" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Enter Official Email</label>
                    <input type="email" required placeholder="name@barangay.gov.ph" class="w-full px-3.5 py-2.5 rounded-xl border border-gray-300 text-sm focus:ring-2 focus:ring-[#1B4D3E] focus:outline-none" />
                </div>
                <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-[#1B4D3E] hover:bg-[#12352B] text-white font-semibold text-sm shadow transition-colors">
                    Request Password Reset Link
                </button>
            </form>
        }

        <div class="text-center pt-2">
            <a asp-action="Login" class="text-xs text-gray-500 hover:text-gray-800">Return to Sign In</a>
        </div>
    </div>
</div>
