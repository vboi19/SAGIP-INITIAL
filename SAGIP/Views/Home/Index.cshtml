@inject I18nService I18nService
@{
    var t = I18nService.T;
    var settings = ViewBag.Settings as SystemSettings ?? new SystemSettings();
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-24 sm:space-y-32">
    <!-- ================= SCREEN 1: DEDICATED SANCTUARY HERO ================= -->
    <!-- Takes up full initial viewport (min-h-[82vh]) so visitors are greeted by calm rather than an info dump -->
    <div class="scroll-snap-section min-h-[82vh] flex flex-col justify-between space-y-8">
        <!-- First-visit inline safety tip (non-blocking) -->
        <div id="inline-safety-tip" class="bg-[#EAF0E8] border border-[#C9D6C5] rounded-xl px-5 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-4" role="region" aria-label="@t.SafetyTip.Title">
            <div class="space-y-0.5 max-w-3xl">
                <p class="text-xs font-semibold tracking-wide text-[#1B3B2B]">
                    @t.SafetyTip.Title
                </p>
                <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                    @t.SafetyTip.Body
                </p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
                <button type="button" onclick="toggleBrowserTips()" class="text-xs font-semibold text-[#214A35] underline underline-offset-2 hover:text-[#152E22] cursor-pointer">
                    @t.SafetyTip.TipsBtn
                </button>
                <button type="button" onclick="dismissInlineSafetyTip()" aria-label="@t.SafetyTip.Dismiss" class="p-1.5 rounded-lg text-[#45544B] hover:text-[#16211A] hover:bg-white/70 transition-colors cursor-pointer">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        <!-- Browser safety tips expandable guide -->
        <div id="browser-tips-guide" class="hidden bg-white border border-[#DCE2D8] rounded-xl p-6 space-y-3">
            <div class="flex items-center justify-between">
                <h2 class="font-serif text-lg font-semibold text-[#16211A]">
                    Browser &amp; Device Safety Tips
                </h2>
                <button type="button" onclick="toggleBrowserTips()" class="text-xs font-medium text-[#66756B] hover:text-[#16211A] cursor-pointer">
                    Close
                </button>
            </div>
            <ul class="grid sm:grid-cols-3 gap-4 text-sm text-[#45544B] pt-2">
                <li class="space-y-1">
                    <p class="font-semibold text-[#1B3B2B]">1. Use a private window</p>
                    <p>Pages opened in Incognito or InPrivate mode are not saved in your device’s browsing history after closing.</p>
                </li>
                <li class="space-y-1">
                    <p class="font-semibold text-[#1B3B2B]">2. Private notebook storage</p>
                    <p>Encrypted notebook entries stay on this browser only and are automatically removed if you close a private window or clear site data.</p>
                </li>
                <li class="space-y-1">
                    <p class="font-semibold text-[#1B3B2B]">3. Keep reference codes safe</p>
                    <p>Avoid saving your report code in shared cloud notes or group chats. Write it down somewhere only you can check.</p>
                </li>
            </ul>
        </div>

        <!-- Hero Grid (2-column balanced split) -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center flex-1 py-4">
            <div class="lg:col-span-7 flex flex-col justify-center space-y-6">
                <p class="text-xs font-semibold tracking-wider uppercase text-[#2F6347]">
                    @t.Home.Kicker@(string.IsNullOrWhiteSpace(settings.BarangayName) || settings.BarangayName == "Barangay VAWC Desk" ? "" : $" · {settings.BarangayName}")
                </p>

                <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-[#16211A] leading-[1.12]">
                    @t.Home.Headline
                </h1>

                <p class="text-base sm:text-lg text-[#45544B] leading-relaxed max-w-xl">
                    @t.Home.Subhead
                </p>

                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
                    <a asp-controller="Report" asp-action="Index" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#214A35] hover:bg-[#183828] text-white text-sm font-semibold transition-all shadow-sm cursor-pointer text-center">
                        <span>@t.Home.StartReport</span>
                        <i data-lucide="arrow-right" class="w-4 h-4 shrink-0"></i>
                    </a>
                    <a asp-controller="Home" asp-action="Contacts" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white border border-[#DCE2D8] hover:border-[#214A35] text-[#1B3B2B] text-sm font-semibold transition-all shadow-xs cursor-pointer text-center">
                        <span>@t.Home.ExploreSupport</span>
                    </a>
                </div>

                <p class="text-xs text-[#66756B] pt-1">@t.Home.MetaLine</p>
            </div>

            <!-- Sanctuary Dignity Anchor Card with Ambient "Hinga" Breathing Cadence -->
            <div class="lg:col-span-5 flex h-full items-center">
                <div class="w-full rounded-3xl bg-[#1B3B2B] text-white p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden group shadow-md min-h-[340px]">
                    <!-- Subtle architectural sanctuary arcs with slow 8-second breathing cadence -->
                    <div class="hinga-arcs-container absolute -right-12 -bottom-12 w-72 h-72 text-white pointer-events-none">
                        <svg aria-hidden="true" class="w-full h-full" viewBox="0 0 200 200" fill="none">
                            <circle class="hinga-ring hinga-ring-3" cx="100" cy="100" r="90" stroke="currentColor" stroke-width="1.5" />
                            <circle class="hinga-ring hinga-ring-2" cx="100" cy="100" r="65" stroke="currentColor" stroke-width="1.5" />
                            <circle class="hinga-ring" cx="100" cy="100" r="40" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                    </div>

                    <p class="text-xs font-medium tracking-widest uppercase text-[#C8DEC9] relative z-10">
                        @t.Home.SanctuaryKicker
                    </p>

                    <div class="py-8 space-y-2 relative z-10">
                        <p class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-white leading-tight">
                            @t.Home.SanctuaryTagalog
                        </p>
                        <p class="font-serif italic text-xl text-[#C8DEC9]">
                            @t.Home.SanctuaryEnglish
                        </p>
                    </div>

                    <div class="pt-4 border-t border-white/15 flex items-center justify-between text-xs text-[#DCE6DA] relative z-10">
                        <span>@t.Home.SanctuaryPillars</span>
                        <i data-lucide="shield-check" class="w-4 h-4 text-[#C8DEC9] shrink-0"></i>
                    </div>
                </div>
            </div>
        </section>

        <!-- Peaceful Scroll Down Prompt -->
        <div class="pt-4 pb-2 flex items-center justify-center text-xs text-[#66756B] gap-2 opacity-80">
            <i data-lucide="arrow-down" class="w-3.5 h-3.5 animate-bounce"></i>
            <span>Scroll down to explore pathways and resources</span>
        </div>
    </div>

    <!-- Calm Pacing Divider -->
    <div class="flex items-center gap-4 text-[#89A08F]">
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
        <span class="text-[11px] uppercase tracking-widest font-mono text-[#66756B] dark:text-[#89a08f]">Available Pathways</span>
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
    </div>

    <!-- ================= SECTION 2: 3 PRIMARY PATHWAYS ================= -->
    <section class="scroll-snap-section min-h-[50vh] flex flex-col justify-center space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#DCE2D8] pb-4">
            <div class="space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wider text-[#2F6347] font-mono">Options For You</p>
                <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-[#16211A]">
                    @t.Home.PathwaysHeading
                </h2>
            </div>
            <p class="text-sm text-[#66756B]">@t.Home.PathwaysSub</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
            <!-- Pathway 01 -->
            <a asp-controller="Report" asp-action="Index" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-2xl p-7 flex flex-col justify-between gap-6 transition-all shadow-xs hover:shadow-sm group cursor-pointer">
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-mono text-[#66756B]">
                        <span class="px-2 py-0.5 rounded bg-[#F6F4EC] text-[#2F6347] font-semibold">01</span>
                        <i data-lucide="file-text" class="w-4 h-4 text-[#2F6347]"></i>
                    </div>
                    <h3 class="font-serif text-xl font-semibold text-[#16211A]">
                        @t.Home.Card1Title
                    </h3>
                    <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Card1Desc</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#214A35] group-hover:translate-x-1 transition-transform">
                    @t.Home.Card1Cta <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
            </a>

            <!-- Pathway 02 -->
            <a asp-controller="Status" asp-action="Index" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-2xl p-7 flex flex-col justify-between gap-6 transition-all shadow-xs hover:shadow-sm group cursor-pointer">
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-mono text-[#66756B]">
                        <span class="px-2 py-0.5 rounded bg-[#F6F4EC] text-[#2F6347] font-semibold">02</span>
                        <i data-lucide="search" class="w-4 h-4 text-[#2F6347]"></i>
                    </div>
                    <h3 class="font-serif text-xl font-semibold text-[#16211A]">
                        @t.Home.Card2Title
                    </h3>
                    <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Card2Desc</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#214A35] group-hover:translate-x-1 transition-transform">
                    @t.Home.Card2Cta <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
            </a>

            <!-- Pathway 03 -->
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-2xl p-7 flex flex-col justify-between gap-6 transition-all shadow-xs hover:shadow-sm group cursor-pointer">
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-mono text-[#66756B]">
                        <span class="px-2 py-0.5 rounded bg-[#F6F4EC] text-[#2F6347] font-semibold">03</span>
                        <i data-lucide="book-open" class="w-4 h-4 text-[#2F6347]"></i>
                    </div>
                    <h3 class="font-serif text-xl font-semibold text-[#16211A]">
                        @t.Home.Card3Title
                    </h3>
                    <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Card3Desc</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#214A35] group-hover:translate-x-1 transition-transform">
                    @t.Home.Card3Cta <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
            </a>
        </div>
    </section>

    <!-- Calm Pacing Divider -->
    <div class="flex items-center gap-4 text-[#89A08F]">
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
        <span class="text-[11px] uppercase tracking-widest font-mono text-[#66756B] dark:text-[#89a08f]">Reporting Process</span>
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
    </div>

    <!-- ================= SECTION 3: PROCESS CLARITY STRIP ================= -->
    <section class="scroll-snap-section bg-[#EAF0E8] border border-[#DCE2D8] rounded-3xl p-8 sm:p-10 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-[#C9D6C5] pb-4">
            <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-[#16211A]">
                @t.Home.ClarityHeading
            </h2>
            <p class="text-sm text-[#45544B]">@t.Home.ClaritySub</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-2">
            <div class="space-y-2">
                <span class="text-xs font-mono font-semibold text-[#2F6347] uppercase tracking-wider">Step 1</span>
                <h3 class="text-lg font-semibold text-[#16211A]">@t.Home.Step1Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Step1Desc</p>
            </div>
            <div class="space-y-2">
                <span class="text-xs font-mono font-semibold text-[#2F6347] uppercase tracking-wider">Step 2</span>
                <h3 class="text-lg font-semibold text-[#16211A]">@t.Home.Step2Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Step2Desc</p>
            </div>
            <div class="space-y-2">
                <span class="text-xs font-mono font-semibold text-[#2F6347] uppercase tracking-wider">Step 3</span>
                <h3 class="text-lg font-semibold text-[#16211A]">@t.Home.Step3Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Step3Desc</p>
            </div>
        </div>
    </section>

    <!-- Calm Pacing Divider -->
    <div class="flex items-center gap-4 text-[#89A08F]">
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
        <span class="text-[11px] uppercase tracking-widest font-mono text-[#66756B] dark:text-[#89a08f]">Private Tools</span>
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
    </div>

    <!-- ================= SECTION 4: ENCRYPTED NOTEBOOK ================= -->
    <section class="scroll-snap-section bg-white border border-[#DCE2D8] rounded-3xl p-8 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8 shadow-xs">
        <div class="space-y-3 max-w-2xl">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#2F6347]">
                <i data-lucide="lock" class="w-4 h-4"></i>
                <span>@t.Home.NotebookKicker</span>
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-[#16211A]">
                @t.Home.NotebookTitle
            </h2>
            <p class="text-sm sm:text-base text-[#45544B] leading-relaxed">@t.Home.NotebookDesc</p>
        </div>

        <div class="w-full lg:w-auto flex flex-col items-stretch sm:items-start lg:items-end gap-2.5 shrink-0">
            <a asp-controller="Home" asp-action="Notebook" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#214A35] hover:bg-[#183828] text-white text-sm font-semibold transition-all shadow-sm cursor-pointer text-center">
                <span>@t.Home.NotebookCta</span>
                <i data-lucide="arrow-right" class="w-4 h-4 shrink-0"></i>
            </a>
            <span class="text-xs text-[#66756B] text-center sm:text-left lg:text-right">@t.Home.NotebookFoot</span>
        </div>
    </section>

    <!-- Calm Pacing Divider -->
    <div class="flex items-center gap-4 text-[#89A08F]">
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
        <span class="text-[11px] uppercase tracking-widest font-mono text-[#66756B] dark:text-[#89a08f]">Know Your Rights</span>
        <span class="h-px bg-[#DCE2D8] dark:bg-[#213c2c] flex-1"></span>
    </div>

    <!-- ================= SECTION 5: KNOWLEDGE PREVIEW ================= -->
    <section class="scroll-snap-section space-y-8 pb-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-[#DCE2D8] pb-4">
            <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-[#2F6347] font-mono">Legal Empowerment</p>
                <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-[#16211A] mt-1">
                    @t.Home.KnowledgeTitle
                </h2>
                <p class="text-sm text-[#45544B] mt-1">@t.Home.KnowledgeSub</p>
            </div>
            <a asp-controller="Home" asp-action="Rights" class="text-sm font-semibold text-[#214A35] hover:underline underline-offset-4 cursor-pointer inline-flex items-center gap-1">
                <span>@t.Home.KnowledgeCta</span>
                <i data-lucide="arrow-right" class="w-4 h-4"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-2xl p-6 space-y-2.5 transition-all shadow-xs hover:shadow-sm cursor-pointer block group">
                <span class="text-xs font-mono text-[#2F6347] font-semibold">01 · Recognizing abuse</span>
                <h3 class="text-base font-semibold text-[#16211A] group-hover:text-[#214A35] transition-colors">@t.Home.K1Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.K1Desc</p>
            </a>
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-2xl p-6 space-y-2.5 transition-all shadow-xs hover:shadow-sm cursor-pointer block group">
                <span class="text-xs font-mono text-[#2F6347] font-semibold">02 · Legal protection</span>
                <h3 class="text-base font-semibold text-[#16211A] group-hover:text-[#214A35] transition-colors">@t.Home.K2Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.K2Desc</p>
            </a>
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-2xl p-6 space-y-2.5 transition-all shadow-xs hover:shadow-sm cursor-pointer block group">
                <span class="text-xs font-mono text-[#2F6347] font-semibold">03 · Protection orders</span>
                <h3 class="text-base font-semibold text-[#16211A] group-hover:text-[#214A35] transition-colors">@t.Home.K3Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.K3Desc</p>
            </a>
        </div>

        <p class="text-xs text-[#66756B] pt-2">@t.Home.Disclaimer</p>
    </section>
</div>

@section Scripts {
<script>
    function toggleBrowserTips() {
        const guide = document.getElementById('browser-tips-guide');
        guide.classList.toggle('hidden');
    }

    function dismissInlineSafetyTip() {
        document.getElementById('inline-safety-tip').style.display = 'none';
        try { localStorage.setItem('sagip_safety_tip_dismissed', 'true'); } catch(e) {}
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (localStorage.getItem('sagip_safety_tip_dismissed') === 'true') {
            const el = document.getElementById('inline-safety-tip');
            if (el) el.style.display = 'none';
        }
    });
</script>
}
