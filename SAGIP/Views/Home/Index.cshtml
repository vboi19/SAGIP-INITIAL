@inject I18nService I18nService
@{
    var t = I18nService.T;
    var settings = ViewBag.Settings as SystemSettings ?? new SystemSettings();
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-14">
    <!-- First-visit inline safety tip (AD-003, non-blocking) -->
    <div id="inline-safety-tip" class="bg-[#EAF0E8] border border-[#C9D6C5] rounded-xl px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4" role="region" aria-label="@t.SafetyTip.Title">
        <div class="space-y-1 max-w-3xl">
            <p class="text-xs font-semibold tracking-wide text-[#1B3B2B]">
                @t.SafetyTip.Title
            </p>
            <p class="text-sm text-[#45544B] leading-relaxed">
                @t.SafetyTip.Body
            </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
            <button type="button" onclick="toggleBrowserTips()" class="text-xs font-semibold text-[#214A35] underline underline-offset-2 hover:text-[#152E22] cursor-pointer">
                @t.SafetyTip.TipsBtn
            </button>
            <button type="button" onclick="dismissInlineSafetyTip()" aria-label="@t.SafetyTip.Dismiss" class="p-1.5 rounded-lg text-[#45544B] hover:text-[#16211A] hover:bg-white/70 transition-colors cursor-pointer">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
    </div>

    <!-- Browser safety tips expandable guide -->
    <div id="browser-tips-guide" class="hidden bg-white border border-[#DCE2D8] rounded-xl p-6 space-y-3">
        <div class="flex items-center justify-between">
            <h2 class="font-serif text-lg font-semibold text-[#16211A]">
                Browser &amp; Device Safety Tips
            </h2>
            <button type="button" onclick="toggleBrowserTips()" class="text-xs font-medium text-[#66756B] hover:text-[#16211A] cursor-pointer">
                Close
            </button>
        </div>
        <ul class="grid sm:grid-cols-3 gap-4 text-sm text-[#45544B] pt-2">
            <li class="space-y-1">
                <p class="font-semibold text-[#1B3B2B]">1. Use a private window</p>
                <p>Pages opened in Incognito or InPrivate mode are not saved in your device’s browsing history after closing.</p>
            </li>
            <li class="space-y-1">
                <p class="font-semibold text-[#1B3B2B]">2. Private notebook storage</p>
                <p>Encrypted notebook entries stay on this browser only and are automatically removed if you close a private window or clear site data.</p>
            </li>
            <li class="space-y-1">
                <p class="font-semibold text-[#1B3B2B]">3. Keep reference codes safe</p>
                <p>Avoid saving your report code in shared cloud notes or group chats. Write it down somewhere only you can check.</p>
            </li>
        </ul>
    </div>

    <!-- Editorial Sanctuary Hero (2-column balanced split) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        <div class="lg:col-span-7 flex flex-col justify-center space-y-6 py-2">
            <p class="text-xs font-semibold tracking-wider uppercase text-[#2F6347]">
                @t.Home.Kicker@(string.IsNullOrWhiteSpace(settings.BarangayName) || settings.BarangayName == "Barangay VAWC Desk" ? "" : $" · {settings.BarangayName}")
            </p>

            <h1 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight text-[#16211A] leading-[1.12]">
                @t.Home.Headline
            </h1>

            <p class="text-base sm:text-lg text-[#45544B] leading-relaxed max-w-xl">
                @t.Home.Subhead
            </p>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
                <a asp-controller="Report" asp-action="Index" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-[#214A35] hover:bg-[#183828] text-white text-sm font-semibold transition-colors cursor-pointer text-center">
                    <span>@t.Home.StartReport</span>
                    <i data-lucide="arrow-right" class="w-4 h-4 shrink-0"></i>
                </a>
                <a asp-controller="Home" asp-action="Contacts" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-white border border-[#DCE2D8] hover:border-[#214A35] text-[#1B3B2B] text-sm font-semibold transition-colors cursor-pointer text-center">
                    <span>@t.Home.ExploreSupport</span>
                </a>
            </div>

            <p class="text-xs text-[#66756B] pt-1">@t.Home.MetaLine</p>
        </div>

        <!-- Sanctuary Dignity Anchor Card with Ambient "Hinga" Breathing Cadence -->
        <div class="lg:col-span-5 flex">
            <div class="w-full rounded-2xl bg-[#1B3B2B] text-white p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden group">
                <!-- Subtle architectural sanctuary arcs with slow 8-second breathing cadence -->
                <div class="hinga-arcs-container absolute -right-12 -bottom-12 w-72 h-72 text-white pointer-events-none">
                    <svg aria-hidden="true" class="w-full h-full" viewBox="0 0 200 200" fill="none">
                        <circle class="hinga-ring hinga-ring-3" cx="100" cy="100" r="90" stroke="currentColor" stroke-width="1.5" />
                        <circle class="hinga-ring hinga-ring-2" cx="100" cy="100" r="65" stroke="currentColor" stroke-width="1.5" />
                        <circle class="hinga-ring" cx="100" cy="100" r="40" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                </div>

                <p class="text-xs font-medium tracking-widest uppercase text-[#C8DEC9] relative z-10">
                    @t.Home.SanctuaryKicker
                </p>

                <div class="py-8 space-y-2 relative z-10">
                    <p class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-white leading-tight">
                        @t.Home.SanctuaryTagalog
                    </p>
                    <p class="font-serif italic text-xl text-[#C8DEC9]">
                        @t.Home.SanctuaryEnglish
                    </p>
                </div>

                <div class="pt-4 border-t border-white/15 flex items-center justify-between text-xs text-[#DCE6DA] relative z-10">
                    <span>@t.Home.SanctuaryPillars</span>
                    <i data-lucide="shield-check" class="w-4 h-4 text-[#C8DEC9] shrink-0"></i>
                </div>
            </div>
        </div>
    </section>

    <!-- 3 Primary Pathways -->
    <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-[#DCE2D8] pb-4">
            <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-[#16211A]">
                @t.Home.PathwaysHeading
            </h2>
            <p class="text-sm text-[#66756B]">@t.Home.PathwaysSub</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Pathway 01 -->
            <a asp-controller="Report" asp-action="Index" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-xl p-6 flex flex-col justify-between gap-6 transition-colors group cursor-pointer">
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-mono text-[#66756B]">
                        <span>01</span>
                        <i data-lucide="file-text" class="w-4 h-4 text-[#2F6347]"></i>
                    </div>
                    <h3 class="font-serif text-xl font-semibold text-[#16211A]">
                        @t.Home.Card1Title
                    </h3>
                    <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Card1Desc</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#214A35] group-hover:translate-x-0.5 transition-transform">
                    @t.Home.Card1Cta <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
            </a>

            <!-- Pathway 02 -->
            <a asp-controller="Status" asp-action="Index" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-xl p-6 flex flex-col justify-between gap-6 transition-colors group cursor-pointer">
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-mono text-[#66756B]">
                        <span>02</span>
                        <i data-lucide="search" class="w-4 h-4 text-[#2F6347]"></i>
                    </div>
                    <h3 class="font-serif text-xl font-semibold text-[#16211A]">
                        @t.Home.Card2Title
                    </h3>
                    <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Card2Desc</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#214A35] group-hover:translate-x-0.5 transition-transform">
                    @t.Home.Card2Cta <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
            </a>

            <!-- Pathway 03 -->
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-xl p-6 flex flex-col justify-between gap-6 transition-colors group cursor-pointer">
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs font-mono text-[#66756B]">
                        <span>03</span>
                        <i data-lucide="book-open" class="w-4 h-4 text-[#2F6347]"></i>
                    </div>
                    <h3 class="font-serif text-xl font-semibold text-[#16211A]">
                        @t.Home.Card3Title
                    </h3>
                    <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Card3Desc</p>
                </div>
                <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#214A35] group-hover:translate-x-0.5 transition-transform">
                    @t.Home.Card3Cta <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
            </a>
        </div>
    </section>

    <!-- Process Clarity Strip -->
    <section class="bg-[#EAF0E8] border border-[#DCE2D8] rounded-2xl p-6 sm:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <h2 class="font-serif text-2xl font-semibold text-[#16211A]">
                @t.Home.ClarityHeading
            </h2>
            <p class="text-sm text-[#45544B]">@t.Home.ClaritySub</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2 border-t border-[#C9D6C5]">
            <div class="space-y-1.5 pt-2">
                <span class="text-xs font-mono font-semibold text-[#2F6347]">Step 1</span>
                <h3 class="text-base font-semibold text-[#16211A]">@t.Home.Step1Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Step1Desc</p>
            </div>
            <div class="space-y-1.5 pt-2">
                <span class="text-xs font-mono font-semibold text-[#2F6347]">Step 2</span>
                <h3 class="text-base font-semibold text-[#16211A]">@t.Home.Step2Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Step2Desc</p>
            </div>
            <div class="space-y-1.5 pt-2">
                <span class="text-xs font-mono font-semibold text-[#2F6347]">Step 3</span>
                <h3 class="text-base font-semibold text-[#16211A]">@t.Home.Step3Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.Step3Desc</p>
            </div>
        </div>
    </section>

    <!-- Private Encrypted Notebook Callout -->
    <section class="bg-white border border-[#DCE2D8] rounded-2xl p-6 sm:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#2F6347]">
                <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                <span>@t.Home.NotebookKicker</span>
            </div>
            <h2 class="font-serif text-2xl font-semibold text-[#16211A]">
                @t.Home.NotebookTitle
            </h2>
            <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.NotebookDesc</p>
        </div>

        <div class="w-full lg:w-auto flex flex-col items-stretch sm:items-start lg:items-end gap-2">
            <a asp-controller="Home" asp-action="Notebook" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-[#214A35] hover:bg-[#183828] text-white text-sm font-semibold transition-colors cursor-pointer text-center">
                <span>@t.Home.NotebookCta</span>
                <i data-lucide="arrow-right" class="w-4 h-4 shrink-0"></i>
            </a>
            <span class="text-xs text-[#66756B] text-center sm:text-left lg:text-right">@t.Home.NotebookFoot</span>
        </div>
    </section>

    <!-- Knowledge Preview -->
    <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
            <div>
                <h2 class="font-serif text-2xl font-semibold text-[#16211A]">
                    @t.Home.KnowledgeTitle
                </h2>
                <p class="text-sm text-[#45544B] mt-1">@t.Home.KnowledgeSub</p>
            </div>
            <a asp-controller="Home" asp-action="Rights" class="text-sm font-semibold text-[#214A35] hover:underline underline-offset-4 cursor-pointer">
                @t.Home.KnowledgeCta →
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-xl p-6 space-y-2 transition-colors cursor-pointer block">
                <span class="text-xs font-mono text-[#2F6347]">01 · Know your options</span>
                <h3 class="text-base font-semibold text-[#16211A]">@t.Home.K1Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.K1Desc</p>
            </a>
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-xl p-6 space-y-2 transition-colors cursor-pointer block">
                <span class="text-xs font-mono text-[#2F6347]">02 · Know your options</span>
                <h3 class="text-base font-semibold text-[#16211A]">@t.Home.K2Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.K2Desc</p>
            </a>
            <a asp-controller="Home" asp-action="Rights" class="text-left bg-white border border-[#DCE2D8] hover:border-[#214A35] rounded-xl p-6 space-y-2 transition-colors cursor-pointer block">
                <span class="text-xs font-mono text-[#2F6347]">03 · Know your options</span>
                <h3 class="text-base font-semibold text-[#16211A]">@t.Home.K3Title</h3>
                <p class="text-sm text-[#45544B] leading-relaxed">@t.Home.K3Desc</p>
            </a>
        </div>

        <p class="text-xs text-[#66756B]">@t.Home.Disclaimer</p>
    </section>
</div>

@section Scripts {
<script>
    function toggleBrowserTips() {
        const guide = document.getElementById('browser-tips-guide');
        guide.classList.toggle('hidden');
    }

    function dismissInlineSafetyTip() {
        document.getElementById('inline-safety-tip').style.display = 'none';
        try { localStorage.setItem('sagip_safety_tip_dismissed', 'true'); } catch(e) {}
    }

    document.addEventListener('DOMContentLoaded', function() {
        if (localStorage.getItem('sagip_safety_tip_dismissed') === 'true') {
            const el = document.getElementById('inline-safety-tip');
            if (el) el.style.display = 'none';
        }
    });
</script>
}
