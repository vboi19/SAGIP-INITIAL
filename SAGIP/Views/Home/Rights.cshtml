@inject I18nService I18nService
@{
    ViewData["Title"] = "Your Rights";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 space-y-10">
    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-end border-b border-[#DCE2D8] pb-6">
        <div class="lg:col-span-8 space-y-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-[#2F6347]">
                Know your rights
            </p>
            <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-[#16211A]">
                Knowledge can be a first step.
            </h1>
            <p class="text-sm sm:text-base text-[#45544B] leading-relaxed max-w-2xl">
                Plain-language guides on recognizing abuse, Republic Act 9262, and Barangay Protection Orders. Click any section to explore at your own pace.
            </p>
        </div>

        <div class="lg:col-span-4 bg-[#FBF1EC] dark:bg-[#3D1A14] border border-[#E6C8BC] dark:border-[#7A3626] rounded-2xl p-4 text-xs text-[#8A3422] dark:text-[#FFE0D8] space-y-1">
            <p class="font-semibold dark:text-[#FFA085]">This is general information, not legal advice.</p>
            <p class="dark:text-[#FFCCBC]">In immediate danger? Call 911. SAGIP is not an emergency service.</p>
        </div>
    </div>

    <!-- Controls: Quick expand/collapse helper -->
    <div class="flex items-center justify-between text-xs text-[#66756B] pt-1">
        <span>3 comprehensive guides available below</span>
        <button type="button" onclick="toggleAllRightsSections()" id="toggleAllBtn" class="font-semibold text-[#214A35] hover:underline cursor-pointer flex items-center gap-1">
            <i data-lucide="chevrons-up-down" class="w-3.5 h-3.5"></i>
            <span id="toggleAllBtnText">Expand all</span>
        </button>
    </div>

    <!-- ================= ACCORDION SECTION 01: RECOGNIZING ABUSE ================= -->
    <div class="border border-[#DCE2D8] rounded-2xl bg-white overflow-hidden transition-all shadow-xs">
        <button type="button" onclick="toggleAccordion('rights-sec-1', 'chevron-1')" class="w-full p-5 sm:p-6 text-left flex items-center justify-between gap-4 hover:bg-[#F6F4EC]/60 transition-colors cursor-pointer" aria-expanded="false" aria-controls="rights-sec-1">
            <div class="flex items-center gap-3.5 sm:gap-4">
                <span class="w-9 h-9 rounded-xl bg-[#EAF0E8] text-[#214A35] font-mono text-sm font-bold flex items-center justify-center shrink-0">
                    01
                </span>
                <div>
                    <h2 class="font-serif text-xl sm:text-2xl font-semibold text-[#16211A]">
                        Recognizing abuse
                    </h2>
                    <p class="text-xs text-[#66756B] mt-0.5">
                        Physical, sexual, psychological, and economic harm defined under the law
                    </p>
                </div>
            </div>
            <div class="w-8 h-8 rounded-full bg-[#F6F4EC] flex items-center justify-center text-[#214A35] shrink-0 transition-transform duration-300" id="chevron-1">
                <i data-lucide="chevron-down" class="w-4 h-4"></i>
            </div>
        </button>

        <div id="rights-sec-1" class="hidden border-t border-[#DCE2D8] p-5 sm:p-7 bg-[#F6F4EC]/30">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white border border-[#DCE2D8] rounded-xl p-5 space-y-2 shadow-xs">
                    <div class="w-2 h-2 rounded-full bg-[#8A3422]"></div>
                    <h3 class="text-base font-semibold text-[#1B3B2B]">Physical</h3>
                    <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                        Hitting, slapping, choking, pushing, or any bodily act causing harm, threat, or fear of harm.
                    </p>
                </div>
                <div class="bg-white border border-[#DCE2D8] rounded-xl p-5 space-y-2 shadow-xs">
                    <div class="w-2 h-2 rounded-full bg-[#8A3422]"></div>
                    <h3 class="text-base font-semibold text-[#1B3B2B]">Sexual</h3>
                    <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                        Any sexual act or attempt without consent, including forced intimacy, voyeurism, or sexual threats.
                    </p>
                </div>
                <div class="bg-white border border-[#DCE2D8] rounded-xl p-5 space-y-2 shadow-xs">
                    <div class="w-2 h-2 rounded-full bg-[#8A3422]"></div>
                    <h3 class="text-base font-semibold text-[#1B3B2B]">Psychological</h3>
                    <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                        Humiliation, stalking, verbal harassment, isolating from loved ones, or ongoing intimidation.
                    </p>
                </div>
                <div class="bg-white border border-[#DCE2D8] rounded-xl p-5 space-y-2 shadow-xs">
                    <div class="w-2 h-2 rounded-full bg-[#8A3422]"></div>
                    <h3 class="text-base font-semibold text-[#1B3B2B]">Economic</h3>
                    <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                        Controlling household finances, withholding basic support, destroying personal property, or stopping work.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= ACCORDION SECTION 02: RA 9262 IN PLAIN LANGUAGE ================= -->
    <div class="border border-[#DCE2D8] rounded-2xl bg-white overflow-hidden transition-all shadow-xs">
        <button type="button" onclick="toggleAccordion('rights-sec-2', 'chevron-2')" class="w-full p-5 sm:p-6 text-left flex items-center justify-between gap-4 hover:bg-[#F6F4EC]/60 transition-colors cursor-pointer" aria-expanded="false" aria-controls="rights-sec-2">
            <div class="flex items-center gap-3.5 sm:gap-4">
                <span class="w-9 h-9 rounded-xl bg-[#EAF0E8] text-[#214A35] font-mono text-sm font-bold flex items-center justify-center shrink-0">
                    02
                </span>
                <div>
                    <h2 class="font-serif text-xl sm:text-2xl font-semibold text-[#16211A]">
                        RA 9262, in plain language
                    </h2>
                    <p class="text-xs text-[#66756B] mt-0.5">
                        Who is protected, legal relationships covered, and how the VAWC desk responds
                    </p>
                </div>
            </div>
            <div class="w-8 h-8 rounded-full bg-[#F6F4EC] flex items-center justify-center text-[#214A35] shrink-0 transition-transform duration-300" id="chevron-2">
                <i data-lucide="chevron-down" class="w-4 h-4"></i>
            </div>
        </button>

        <div id="rights-sec-2" class="hidden border-t border-[#DCE2D8] p-5 sm:p-7 bg-[#F6F4EC]/30">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <div class="lg:col-span-7 bg-white border border-[#DCE2D8] rounded-2xl p-6 sm:p-7 space-y-3 shadow-xs">
                    <p class="text-xs font-mono text-[#2F6347] uppercase tracking-wider font-semibold">Scope &amp; Coverage</p>
                    <h3 class="font-serif text-lg font-semibold text-[#16211A]">The Anti-VAWC Act</h3>
                    <p class="text-sm text-[#45544B] leading-relaxed">
                        The <strong>Anti-Violence Against Women and Their Children Act (RA 9262)</strong> protects women and their children from physical, sexual, psychological, or economic abuse committed by a current or former spouse/partner, dating partner, or someone with whom they share a child.
                    </p>
                </div>

                <div class="lg:col-span-5 bg-[#EAF0E8] border border-[#C9D6C5] rounded-2xl p-6 sm:p-7 space-y-3 shadow-xs">
                    <p class="text-xs font-mono text-[#2F6347] uppercase tracking-wider font-semibold">Desk Procedure</p>
                    <h3 class="font-serif text-lg font-semibold text-[#1B3B2B]">How SAGIP handles reports</h3>
                    <ul class="space-y-2 text-xs sm:text-sm text-[#45544B] list-disc pl-4 leading-relaxed">
                        <li>Women and their children follow direct RA 9262 handling at the barangay VAWC desk.</li>
                        <li>For other victims (e.g. elderly or non-intimate disputes), the desk records the intake and coordinates external referrals to DSWD or PAO.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= ACCORDION SECTION 03: PROTECTION ORDERS EXPLAINED ================= -->
    <div class="border border-[#DCE2D8] rounded-2xl bg-white overflow-hidden transition-all shadow-xs">
        <button type="button" onclick="toggleAccordion('rights-sec-3', 'chevron-3')" class="w-full p-5 sm:p-6 text-left flex items-center justify-between gap-4 hover:bg-[#F6F4EC]/60 transition-colors cursor-pointer" aria-expanded="false" aria-controls="rights-sec-3">
            <div class="flex items-center gap-3.5 sm:gap-4">
                <span class="w-9 h-9 rounded-xl bg-[#EAF0E8] text-[#214A35] font-mono text-sm font-bold flex items-center justify-center shrink-0">
                    03
                </span>
                <div>
                    <h2 class="font-serif text-xl sm:text-2xl font-semibold text-[#16211A]">
                        Protection orders, explained
                    </h2>
                    <p class="text-xs text-[#66756B] mt-0.5">
                        Barangay Protection Orders (BPO), application steps, and 15-day enforcement
                    </p>
                </div>
            </div>
            <div class="w-8 h-8 rounded-full bg-[#F6F4EC] flex items-center justify-center text-[#214A35] shrink-0 transition-transform duration-300" id="chevron-3">
                <i data-lucide="chevron-down" class="w-4 h-4"></i>
            </div>
        </button>

        <div id="rights-sec-3" class="hidden border-t border-[#DCE2D8] p-5 sm:p-7 bg-[#F6F4EC]/30">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div class="bg-white border border-[#DCE2D8] rounded-xl p-5 space-y-2 shadow-xs">
                    <span class="text-xs font-mono font-semibold text-[#2F6347]">01</span>
                    <h3 class="text-base font-semibold text-[#16211A]">What a BPO is</h3>
                    <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                        A Barangay Protection Order is issued directly by the Punong Barangay (or Kagawad in absence) ordering the perpetrator to cease all violence, threats, or harassment for 15 days.
                    </p>
                </div>
                <div class="bg-white border border-[#DCE2D8] rounded-xl p-5 space-y-2 shadow-xs">
                    <span class="text-xs font-mono font-semibold text-[#2F6347]">02</span>
                    <h3 class="text-base font-semibold text-[#16211A]">Where to ask</h3>
                    <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                        Request assistance at your local barangay VAWC desk. Identified participation is legally required for official BPO issuance so legal documents can be served.
                    </p>
                </div>
                <div class="bg-white border border-[#DCE2D8] rounded-xl p-5 space-y-2 shadow-xs">
                    <span class="text-xs font-mono font-semibold text-[#2F6347]">03</span>
                    <h3 class="text-base font-semibold text-[#16211A]">After it is issued</h3>
                    <p class="text-xs sm:text-sm text-[#45544B] leading-relaxed">
                        The desk officer records "BPO Issued" in SAGIP. If the perpetrator violates the order, they face direct arrest and prosecution under Section 12 of RA 9262.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Action Card -->
    <div class="bg-[#1B3B2B] text-white rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-md">
        <div class="space-y-1">
            <h2 class="font-serif text-2xl font-semibold">Ready to reach out?</h2>
            <p class="text-xs sm:text-sm text-[#DCE6DA]">
                You decide what to share. No account needed. Anonymous reporting available.
            </p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0 w-full sm:w-auto">
            <a asp-controller="Status" asp-action="Index" class="w-full sm:w-auto px-4 py-2.5 rounded-xl border border-white/25 text-white text-xs sm:text-sm font-semibold hover:bg-white/10 transition-colors cursor-pointer text-center">
                Check status
            </a>
            <a asp-controller="Report" asp-action="Index" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-white text-[#1B3B2B] text-xs sm:text-sm font-semibold hover:bg-[#EAF0E8] transition-colors cursor-pointer text-center">
                <span>Start a report</span>
                <i data-lucide="arrow-right" class="w-4 h-4 shrink-0"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleAccordion(panelId, chevronId) {
        const panel = document.getElementById(panelId);
        const chevron = document.getElementById(chevronId);
        if (!panel) return;

        const isHidden = panel.classList.contains('hidden');
        if (isHidden) {
            panel.classList.remove('hidden');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
        } else {
            panel.classList.add('hidden');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
        }
    }

    function toggleAllRightsSections() {
        const panels = ['rights-sec-1', 'rights-sec-2', 'rights-sec-3'];
        const chevrons = ['chevron-1', 'chevron-2', 'chevron-3'];
        const btnText = document.getElementById('toggleAllBtnText');
        const anyHidden = panels.some(id => document.getElementById(id)?.classList.contains('hidden'));

        panels.forEach((id, index) => {
            const panel = document.getElementById(id);
            const chevron = document.getElementById(chevrons[index]);
            if (panel) {
                if (anyHidden) {
                    panel.classList.remove('hidden');
                    if (chevron) chevron.style.transform = 'rotate(180deg)';
                } else {
                    panel.classList.add('hidden');
                    if (chevron) chevron.style.transform = 'rotate(0deg)';
                }
            }
        });

        if (btnText) {
            btnText.textContent = anyHidden ? 'Collapse all' : 'Expand all';
        }
    }

    // Default: Open the first section so users have immediate context
    document.addEventListener('DOMContentLoaded', function() {
        toggleAccordion('rights-sec-1', 'chevron-1');
    });
</script>
}
