@{
    ViewData["Title"] = "Accessibility & Usability";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 space-y-6">
    <div class="bg-white border border-[#DCE2D8] rounded-2xl p-6 sm:p-10 space-y-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-[#2F6347]">
            Accessibility &amp; Usability
        </p>
        <h1 class="font-serif text-3xl font-semibold text-[#16211A]">
            Designed to be clear, calm, and accessible.
        </h1>
        <ul class="space-y-3 text-sm text-[#45544B] list-disc pl-5 leading-relaxed">
            <li>All reporter flows support keyboard navigation and visible focus rings.</li>
            <li>Text contrast meets WCAG AA standards across light linen and deep forest surfaces.</li>
            <li>Status and alerts always combine color with clear text labels and icons.</li>
            <li>Responsive layouts are tested down to 360 px wide mobile screens.</li>
            <li>All reporter-facing pages are available in English and Filipino.</li>
        </ul>
        <a asp-controller="Home" asp-action="Index" class="inline-block text-sm font-semibold text-[#214A35] hover:underline cursor-pointer">
            ← Back to home
        </a>
    </div>
</div>
