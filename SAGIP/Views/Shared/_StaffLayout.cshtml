@inject IHttpContextAccessor HttpContextAccessor
@{
    var staffRole = HttpContextAccessor.HttpContext?.Session.GetString("StaffUserRole") ?? "DeskOfficer";
    var staffName = HttpContextAccessor.HttpContext?.Session.GetString("StaffUserName") ?? "Staff User";
    var staffEmail = HttpContextAccessor.HttpContext?.Session.GetString("StaffUserEmail") ?? "staff@barangay.gov.ph";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab))
    {
        activeTab = (currentController == "Admin") ? "staff" : "overview";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} · " : "")sagip</title>

    <!-- Google Fonts matching @@fontsource imports in SAGIP-INITIAL -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Immediate Theme Initialization (Prevents flash of light theme) -->
    <script>
        (function () {
            const theme = localStorage.getItem('sagip_theme');
            if (theme === 'dark' || (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        forest: {
                            950: '#152E22',
                            900: '#1B3B2B',
                            800: '#214A35',
                            700: '#2F6347',
                        },
                        sage: {
                            200: '#C9D6C5',
                            100: '#EAF0E8',
                            50: '#F2F5EF',
                        },
                        terracotta: {
                            800: '#8A3422',
                            700: '#9A3F2B',
                            200: '#E6C8BC',
                            50: '#FBF1EC',
                        },
                        canvas: '#F6F4EC',
                        surface: '#FFFFFF',
                        mist: '#EEF2EB',
                        hairline: '#DCE2D8',
                    },
                    fontFamily: {
                        serif: ['Fraunces', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace'],
                    }
                }
            }
        };
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html, body {
            overflow-x: hidden;
            max-width: 100vw;
        }
        body {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #F6F4EC;
            color: #16211A;
        }
        .font-serif {
            font-family: 'Fraunces', Georgia, serif;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        .tabular-nums {
            font-variant-numeric: tabular-nums;
        }

        /* Comprehensive Dark Mode Rules */
        html.dark {
            color-scheme: dark;
        }
        html.dark, html.dark body {
            background-color: #0c1711 !important;
            color: #eaf0e8 !important;
        }
        html.dark .bg-\[\#F6F4EC\],
        html.dark [class*="bg-[#F6F4EC]"] {
            background-color: #0c1711 !important;
        }
        html.dark .bg-white {
            background-color: #13241b !important;
            color: #eaf0e8 !important;
            border-color: #213c2c !important;
        }
        html.dark .bg-\[\#EAF0E8\],
        html.dark [class*="bg-[#EAF0E8]"] {
            background-color: #172d21 !important;
            color: #d6e4d8 !important;
        }
        html.dark .bg-\[\#F2F5EF\],
        html.dark [class*="bg-[#F2F5EF]"] {
            background-color: #15291f !important;
        }
        html.dark .bg-\[\#FBF1EC\] {
            background-color: #2b1510 !important;
            border-color: #592419 !important;
            color: #f4c2b7 !important;
        }
        html.dark .border-\[\#DCE2D8\],
        html.dark .border-\[\#C9D6C5\],
        html.dark .border-\[\#E2DEC9\] {
            border-color: #213c2c !important;
        }
        html.dark .divide-\[\#DCE2D8\] > :not([hidden]) ~ :not([hidden]) {
            border-color: #213c2c !important;
        }
        html.dark .text-\[\#16211A\],
        html.dark .text-\[\#1B3B2B\] {
            color: #eaf0e8 !important;
        }
        html.dark .text-\[\#45544B\] {
            color: #adc1b2 !important;
        }
        html.dark .text-\[\#66756B\],
        html.dark .text-\[\#526058\] {
            color: #89a08f !important;
        }
        html.dark .text-\[\#214A35\],
        html.dark .text-\[\#2F6347\] {
            color: #6bbe8c !important;
        }
        html.dark input,
        html.dark select,
        html.dark textarea {
            background-color: #102117 !important;
            color: #eaf0e8 !important;
            border-color: #284735 !important;
        }
        html.dark input::placeholder,
        html.dark textarea::placeholder {
            color: #667e6e !important;
        }
        html.dark .hover\:bg-\[\#EAF0E8\]\/50:hover {
            background-color: rgba(23, 45, 33, 0.6) !important;
        }
        html.dark tr.hover\:bg-\[\#EAF0E8\]\/50:hover td {
            background-color: rgba(23, 45, 33, 0.6) !important;
        }
        html.dark .bg-\[\#F6F4EC\] table thead,
        html.dark table thead.bg-\[\#F6F4EC\] {
            background-color: #102117 !important;
        }

        /* Ambient Transitions & Animation System */
        body, header, aside, main, footer {
            transition: background-color 300ms ease, color 300ms ease, border-color 300ms ease;
        }

        .celestial-morph-icon {
            transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
        }

        @@media (prefers-reduced-motion: reduce) {
            .celestial-morph-icon, body, header, aside, main, footer {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen bg-[#F6F4EC] text-[#16211A] overflow-x-hidden">
    <div class="min-h-screen bg-[#F6F4EC] text-[#16211A] flex flex-col lg:flex-row overflow-x-hidden">
        <!-- Sidebar -->
        <aside class="lg:w-64 bg-[#1B3B2B] text-white flex flex-col justify-between shrink-0">
            <div class="p-6 space-y-6">
                <div>
                    <span class="font-serif text-2xl font-semibold tracking-tight block">sagip</span>
                    <span class="text-[11px] uppercase tracking-widest text-[#C9D6C5]">
                        @(currentController == "Admin" ? "System Administration" : "VAWC Desk Workspace")
                    </span>
                </div>

                @if (currentController == "Admin")
                {
                    <nav class="space-y-1 text-sm" aria-label="Administrator navigation">
                        <a href="@Url.Action("Index", "Admin", new { tab = "staff" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "staff" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Staff accounts
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "contacts" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "contacts" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Support contacts
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "settings" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "settings" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            System settings
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "audit" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "audit" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Audit logs
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "stats" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "stats" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Anonymized statistics
                        </a>
                    </nav>

                    <!-- Strict RBAC Proof Guard -->
                    <div class="pt-4 border-t border-white/10 space-y-2">
                        <p class="text-[11px] text-[#C9D6C5] leading-relaxed">
                            Administrators have no access to case narratives or reporter identities.
                        </p>
                        <form asp-controller="Admin" asp-action="AttemptCaseAccess" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="caseNumber" value="C-026-041" />
                            <button type="submit" class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-white/20 text-[11px] text-[#DCE2D8] hover:bg-white/10 cursor-pointer">
                                <i data-lucide="shield-ban" class="w-3.5 h-3.5"></i>
                                <span>Test case access guard</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <nav class="space-y-1 text-sm" aria-label="Desk workspace navigation">
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "overview" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "overview" && currentAction != "Details" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Overview
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "all" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "all" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            All cases
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "mine" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "mine" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Assigned to me
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "stats" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "stats" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Anonymized statistics
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "contacts" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "contacts" ? "bg-[#214A35] text-white font-semibold" : "text-[#DCE2D8] hover:bg-white/10 hover:text-white")">
                            Support contacts
                        </a>
                    </nav>
                }
            </div>

            <div class="p-6 border-t border-white/10 space-y-3 text-xs">
                <div>
                    <p class="text-[#C9D6C5] uppercase tracking-wider text-[10px]">@(currentController == "Admin" ? "Administrator" : "Desk officer")</p>
                    <p class="font-semibold text-white mt-0.5">@staffName</p>
                    <p class="text-[#DCE2D8]">@staffEmail</p>
                </div>
                <div class="flex flex-col items-start gap-2 pt-1">
                    <button type="button" onclick="toggleTheme()" class="inline-flex items-center gap-2 text-[#C9D6C5] hover:text-white cursor-pointer py-1">
                        <span class="relative w-3.5 h-3.5 flex items-center justify-center shrink-0 overflow-hidden">
                            <i data-lucide="sun" id="staff-theme-icon-sun" class="celestial-morph-icon w-3.5 h-3.5 absolute text-amber-300 transform scale-100 rotate-0 opacity-100"></i>
                            <i data-lucide="moon" id="staff-theme-icon-moon" class="celestial-morph-icon w-3.5 h-3.5 absolute text-[#C9D6C5] transform scale-0 -rotate-90 opacity-0"></i>
                        </span>
                        <span id="staff-theme-text">Light mode</span>
                    </button>
                    <form asp-controller="Staff" asp-action="Logout" method="post" class="w-full">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center gap-1.5 text-[#DCE2D8] hover:text-white cursor-pointer">
                            <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                            <span>Sign out</span>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Content Canvas -->
        <main class="flex-1 p-6 sm:p-8 lg:p-10 max-w-6xl">
            @if (TempData["SuccessMessage"] != null)
            {
                <div role="alert" class="rounded-xl px-4 py-3 text-xs font-medium bg-[#EAF0E8] border border-[#C9D6C5] text-[#1B3B2B] mb-6">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div role="alert" class="rounded-xl px-4 py-3 text-xs font-medium bg-[#FBF1EC] border border-[#E6C8BC] text-[#8A3422] mb-6">
                    @TempData["ErrorMessage"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script>
        lucide.createIcons();

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('sagip_theme', isDark ? 'dark' : 'light');
            syncThemeUI();
        }

        function syncThemeUI() {
            const isDark = document.documentElement.classList.contains('dark');
            const sun = document.getElementById('staff-theme-icon-sun');
            const moon = document.getElementById('staff-theme-icon-moon');
            const text = document.getElementById('staff-theme-text');

            if (sun && moon) {
                if (isDark) {
                    sun.style.transform = 'scale(0) rotate(90deg)';
                    sun.style.opacity = '0';
                    moon.style.transform = 'scale(1) rotate(0deg)';
                    moon.style.opacity = '1';
                    if (text) text.textContent = 'Light mode';
                } else {
                    sun.style.transform = 'scale(1) rotate(0deg)';
                    sun.style.opacity = '1';
                    moon.style.transform = 'scale(0) rotate(-90deg)';
                    moon.style.opacity = '0';
                    if (text) text.textContent = 'Dark mode';
                }
            }

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        document.addEventListener('DOMContentLoaded', syncThemeUI);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
