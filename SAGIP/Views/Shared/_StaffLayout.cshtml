@inject IHttpContextAccessor HttpContextAccessor
@{
    var staffRole = HttpContextAccessor.HttpContext?.Session.GetString("StaffUserRole") ?? "DeskOfficer";
    var staffName = HttpContextAccessor.HttpContext?.Session.GetString("StaffUserName") ?? "Staff User";
    var staffEmail = HttpContextAccessor.HttpContext?.Session.GetString("StaffUserEmail") ?? "staff@barangay.gov.ph";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var activeTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(activeTab))
    {
        activeTab = (currentController == "Admin") ? "staff" : "overview";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} · " : "")sagip</title>

    <!-- Google Fonts matching @@fontsource imports in SAGIP-INITIAL -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Immediate Theme Initialization (Prevents flash of light theme) -->
    <script>
        (function () {
            const theme = localStorage.getItem('sagip_theme');
            if (theme === 'dark' || (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        ink: {
                            DEFAULT: '#0D1321',
                            950: '#070A12',
                            900: '#0D1321',
                            800: '#151F34',
                        },
                        space: {
                            DEFAULT: '#1D2D44',
                            900: '#131E2E',
                            800: '#1D2D44',
                            700: '#263B59',
                            600: '#324D73',
                        },
                        slate: {
                            DEFAULT: '#3E5C76',
                            700: '#334C62',
                            600: '#3E5C76',
                            500: '#4E7292',
                        },
                        denim: {
                            DEFAULT: '#748CAB',
                            400: '#748CAB',
                            300: '#8FA3BD',
                            200: '#B0C1D4',
                            100: '#D5DFEC',
                        },
                        eggshell: {
                            DEFAULT: '#F0EBD8',
                            50: '#FAF8F3',
                            100: '#F5F1E5',
                            200: '#F0EBD8',
                            300: '#E4DCBF',
                            400: '#D5C9A4',
                        },
                        canvas: '#F0EBD8',
                        surface: '#FFFFFF',
                    },
                    fontFamily: {
                        serif: ['Fraunces', 'Georgia', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace'],
                    }
                }
            }
        };
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        html, body {
            overflow-x: hidden;
            max-width: 100vw;
        }

        /* ================= PALETTE: DEEP SPACE & BLUE SLATE =================
           #0D1321 - Ink Black
           #1D2D44 - Deep Space Blue
           #3E5C76 - Blue Slate
           #748CAB - Dusty Denim
           #F0EBD8 - Eggshell
        */

        body {
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            background-color: #F0EBD8 !important;
            color: #0D1321 !important;
        }
        .font-serif {
            font-family: 'Fraunces', Georgia, serif;
        }
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        .tabular-nums {
            font-variant-numeric: tabular-nums;
        }

        /* Canvas / Main backgrounds */
        .bg-\[\#F6F4EC\], [class*="bg-[#F6F4EC]"] {
            background-color: #F0EBD8 !important;
        }
        
        /* Deep Space Blue: Sidebar, primary desk headers & cards */
        .bg-\[\#1B3B2B\], [class*="bg-[#1B3B2B]"],
        .bg-\[\#152E22\], [class*="bg-[#152E22]"],
        .bg-\[\#1B4D3E\], [class*="bg-[#1B4D3E]"] {
            background-color: #1D2D44 !important;
        }

        /* Interactive Buttons / Actions */
        .bg-\[\#214A35\], [class*="bg-[#214A35]"] {
            background-color: #1D2D44 !important;
        }
        .hover\:bg-\[\#183828\]:hover {
            background-color: #0D1321 !important;
        }
        .hover\:bg-\[\#143d31\]:hover {
            background-color: #0D1321 !important;
        }

        /* Soft Denim Tinted Containers */
        .bg-\[\#EAF0E8\], [class*="bg-[#EAF0E8]"],
        .bg-\[\#F2F5EF\], [class*="bg-[#F2F5EF]"] {
            background-color: rgba(116, 140, 171, 0.16) !important;
        }
        .hover\:bg-\[\#EAF0E8\]\/50:hover, tr.hover\:bg-\[\#EAF0E8\]\/50:hover td {
            background-color: rgba(116, 140, 171, 0.20) !important;
        }

        /* Table Headers in Light Mode: Soft Eggshell Tone */
        .bg-\[\#F6F4EC\] table thead, table thead.bg-\[\#F6F4EC\] {
            background-color: #E6DFC9 !important;
            color: #1D2D44 !important;
            border-color: rgba(116, 140, 171, 0.35) !important;
        }

        /* Hairlines, Dividers & Card Outlines */
        .border-\[\#DCE2D8\], [class*="border-[#DCE2D8]"],
        .border-\[\#C9D6C5\], [class*="border-[#C9D6C5]"],
        .border-\[\#E2DEC9\], [class*="border-[#E2DEC9]"] {
            border-color: rgba(116, 140, 171, 0.35) !important;
        }
        .divide-\[\#DCE2D8\] > :not([hidden]) ~ :not([hidden]) {
            border-color: rgba(116, 140, 171, 0.35) !important;
        }
        .border-\[\#214A35\], [class*="border-[#214A35]"],
        .border-\[\#1B3B2B\], [class*="border-[#1B3B2B]"],
        .border-\[\#1B4D3E\], [class*="border-[#1B4D3E]"] {
            border-color: #1D2D44 !important;
        }

        /* Typography & Text Accent Mappings */
        .text-\[\#16211A\], [class*="text-[#16211A]"],
        .text-\[\#1B3B2B\], [class*="text-[#1B3B2B]"] {
            color: #0D1321 !important;
        }
        .text-\[\#1B4D3E\], [class*="text-[#1B4D3E]"] {
            color: #1D2D44 !important;
        }
        .text-\[\#214A35\], [class*="text-[#214A35]"],
        .text-\[\#2F6347\], [class*="text-[#2F6347]"] {
            color: #1D2D44 !important;
        }
        .text-\[\#45544B\], [class*="text-[#45544B]"] {
            color: #2D415A !important;
        }
        .text-\[\#66756B\], [class*="text-[#66756B]"],
        .text-\[\#526058\], [class*="text-[#526058]"] {
            color: #556E8B !important;
        }
        .text-\[\#C9D6C5\], [class*="text-[#C9D6C5]"],
        .text-\[\#DCE2D8\], [class*="text-[#DCE2D8]"] {
            color: #B0C1D4 !important;
        }

        /* Focus & Rings */
        .focus\:ring-\[\#1B4D3E\]:focus,
        .focus\:border-\[\#214A35\]:focus {
            border-color: #3E5C76 !important;
            --tw-ring-color: #3E5C76 !important;
        }

        /* Action Buttons & Badges across Details & Admin tools */
        .bg-emerald-800, [class*="bg-emerald-800"] {
            background-color: #1D2D44 !important;
        }
        .hover\:bg-emerald-900:hover {
            background-color: #0D1321 !important;
        }
        .text-emerald-800, [class*="text-emerald-800"] {
            color: #3E5C76 !important;
        }
        .bg-purple-700, [class*="bg-purple-700"] {
            background-color: #3E5C76 !important;
        }
        .hover\:bg-purple-800:hover {
            background-color: #1D2D44 !important;
        }
        .bg-emerald-100 {
            background-color: rgba(116, 140, 171, 0.20) !important;
            color: #1D2D44 !important;
            border-color: #748CAB !important;
        }
        input[type="checkbox"], input[type="radio"] {
            accent-color: #1D2D44;
        }

        /* ================= COMPREHENSIVE DARK MODE: INK BLACK & SPACE BLUE ================= */
        html.dark {
            color-scheme: dark;
        }
        html.dark, html.dark body {
            background-color: #0D1321 !important;
            color: #F0EBD8 !important;
        }
        html.dark aside {
            background-color: #090E18 !important;
            border-right: 1px solid #1D2D44 !important;
        }
        html.dark .bg-white {
            background-color: #151F30 !important;
            color: #F0EBD8 !important;
            border-color: #23334D !important;
        }
        html.dark .bg-\[\#F6F4EC\],
        html.dark [class*="bg-[#F6F4EC]"] {
            background-color: #0D1321 !important;
        }
        html.dark .bg-\[\#EAF0E8\],
        html.dark [class*="bg-[#EAF0E8]"] {
            background-color: #1B293E !important;
            color: #D5DFEC !important;
            border-color: #2B3F5D !important;
        }
        html.dark .bg-\[\#F2F5EF\],
        html.dark [class*="bg-[#F2F5EF]"] {
            background-color: #172437 !important;
        }
        html.dark .bg-\[\#1B3B2B\],
        html.dark .bg-\[\#152E22\],
        html.dark .bg-\[\#1B4D3E\] {
            background-color: #1D2D44 !important;
        }
        html.dark .bg-\[\#214A35\] {
            background-color: #3E5C76 !important;
        }
        html.dark .hover\:bg-\[\#183828\]:hover {
            background-color: #4E7292 !important;
        }
        html.dark .border-\[\#DCE2D8\],
        html.dark .border-\[\#C9D6C5\],
        html.dark .border-\[\#E2DEC9\] {
            border-color: #23334D !important;
        }
        html.dark .divide-\[\#DCE2D8\] > :not([hidden]) ~ :not([hidden]) {
            border-color: #23334D !important;
        }
        html.dark .text-\[\#16211A\],
        html.dark .text-\[\#1B3B2B\],
        html.dark .text-\[\#1B4D3E\] {
            color: #F0EBD8 !important;
        }
        html.dark .text-\[\#45544B\] {
            color: #B0C1D4 !important;
        }
        html.dark .text-\[\#66756B\],
        html.dark .text-\[\#526058\] {
            color: #748CAB !important;
        }
        html.dark .text-\[\#214A35\],
        html.dark .text-\[\#2F6347\] {
            color: #8FA3BD !important;
        }
        html.dark input,
        html.dark select,
        html.dark textarea {
            background-color: #0F1724 !important;
            color: #F0EBD8 !important;
            border-color: #23334D !important;
        }
        html.dark input::placeholder,
        html.dark textarea::placeholder {
            color: #56708F !important;
        }
        html.dark .hover\:bg-\[\#EAF0E8\]\/50:hover,
        html.dark tr.hover\:bg-\[\#EAF0E8\]\/50:hover td {
            background-color: rgba(62, 92, 118, 0.25) !important;
        }
        html.dark .bg-\[\#F6F4EC\] table thead,
        html.dark table thead.bg-\[\#F6F4EC\] {
            background-color: #0F1724 !important;
            color: #8FA3BD !important;
            border-color: #23334D !important;
        }
        html.dark .text-emerald-800, html.dark [class*="text-emerald-800"] {
            color: #8FA3BD !important;
        }
        html.dark .bg-emerald-800, html.dark [class*="bg-emerald-800"] {
            background-color: #3E5C76 !important;
        }
        html.dark .hover\:bg-emerald-900:hover {
            background-color: #1D2D44 !important;
        }
        html.dark .bg-purple-700, html.dark [class*="bg-purple-700"] {
            background-color: #3E5C76 !important;
        }
        html.dark .hover\:bg-purple-800:hover {
            background-color: #1D2D44 !important;
        }
        html.dark .bg-emerald-100 {
            background-color: rgba(62, 92, 118, 0.35) !important;
            color: #D5DFEC !important;
            border-color: #3E5C76 !important;
        }
        html.dark input[type="checkbox"], html.dark input[type="radio"] {
            accent-color: #3E5C76;
        }

        /* Ambient Transitions & Animation System */
        body, header, aside, main, footer {
            transition: background-color 300ms ease, color 300ms ease, border-color 300ms ease;
        }

        .celestial-morph-icon {
            transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
        }

        @@media (prefers-reduced-motion: reduce) {
            .celestial-morph-icon, body, header, aside, main, footer {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen bg-[#F0EBD8] text-[#0D1321] overflow-x-hidden">
    <div class="min-h-screen bg-[#F0EBD8] text-[#0D1321] flex flex-col lg:flex-row overflow-x-hidden">
        <!-- Sidebar -->
        <aside class="lg:w-64 bg-[#1D2D44] text-[#F0EBD8] flex flex-col justify-between shrink-0 border-r border-[#0D1321]/30">
            <div class="p-6 space-y-6">
                <div>
                    <span class="font-serif text-2xl font-semibold tracking-tight block text-[#F0EBD8]">sagip</span>
                    <span class="text-[11px] uppercase tracking-widest text-[#748CAB]">
                        @(currentController == "Admin" ? "System Administration" : "VAWC Desk Workspace")
                    </span>
                </div>

                @if (currentController == "Admin")
                {
                    <nav class="space-y-1 text-sm" aria-label="Administrator navigation">
                        <a href="@Url.Action("Index", "Admin", new { tab = "staff" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "staff" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Staff accounts
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "contacts" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "contacts" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Support contacts
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "settings" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "settings" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            System settings
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "audit" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "audit" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Audit logs
                        </a>
                        <a href="@Url.Action("Index", "Admin", new { tab = "stats" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "stats" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Anonymized statistics
                        </a>
                    </nav>

                    <!-- Strict RBAC Proof Guard -->
                    <div class="pt-4 border-t border-white/10 space-y-2">
                        <p class="text-[11px] text-[#748CAB] leading-relaxed">
                            Administrators have no access to case narratives or reporter identities.
                        </p>
                        <form asp-controller="Admin" asp-action="AttemptCaseAccess" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="caseNumber" value="C-026-041" />
                            <button type="submit" class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg border border-white/20 text-[11px] text-[#D5DFEC] hover:bg-white/10 cursor-pointer">
                                <i data-lucide="shield-ban" class="w-3.5 h-3.5"></i>
                                <span>Test case access guard</span>
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <nav class="space-y-1 text-sm" aria-label="Desk workspace navigation">
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "overview" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "overview" && currentAction != "Details" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Overview
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "all" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "all" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            All cases
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "mine" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "mine" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Assigned to me
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "stats" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "stats" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Anonymized statistics
                        </a>
                        <a href="@Url.Action("Index", "DeskOfficer", new { tab = "contacts" })" class="block w-full text-left px-3 py-2 rounded-lg transition-colors cursor-pointer @(activeTab == "contacts" ? "bg-[#3E5C76] text-[#F0EBD8] font-semibold shadow-xs" : "text-[#D5DFEC] hover:bg-white/10 hover:text-white")">
                            Support contacts
                        </a>
                    </nav>
                }
            </div>

            <div class="p-6 border-t border-white/10 space-y-3 text-xs">
                <div>
                    <p class="text-[#748CAB] uppercase tracking-wider text-[10px]">@(currentController == "Admin" ? "Administrator" : "Desk officer")</p>
                    <p class="font-semibold text-[#F0EBD8] mt-0.5">@staffName</p>
                    <p class="text-[#D5DFEC]">@staffEmail</p>
                </div>
                <div class="flex flex-col items-start gap-2 pt-1">
                    <button type="button" onclick="toggleTheme()" class="inline-flex items-center gap-2 text-[#748CAB] hover:text-[#F0EBD8] cursor-pointer py-1">
                        <span class="relative w-3.5 h-3.5 flex items-center justify-center shrink-0 overflow-hidden">
                            <i data-lucide="sun" id="staff-theme-icon-sun" class="celestial-morph-icon w-3.5 h-3.5 absolute text-amber-300 transform scale-100 rotate-0 opacity-100"></i>
                            <i data-lucide="moon" id="staff-theme-icon-moon" class="celestial-morph-icon w-3.5 h-3.5 absolute text-[#748CAB] transform scale-0 -rotate-90 opacity-0"></i>
                        </span>
                        <span id="staff-theme-text">Light mode</span>
                    </button>
                    <form asp-controller="Staff" asp-action="Logout" method="post" class="w-full">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center gap-1.5 text-[#D5DFEC] hover:text-[#F0EBD8] cursor-pointer">
                            <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                            <span>Sign out</span>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Content Canvas -->
        <main class="flex-1 p-6 sm:p-8 lg:p-10 max-w-6xl">
            @if (TempData["SuccessMessage"] != null)
            {
                <div role="alert" class="rounded-xl px-4 py-3 text-xs font-medium bg-[#1D2D44]/10 border border-[#3E5C76]/30 text-[#1D2D44] mb-6">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div role="alert" class="rounded-xl px-4 py-3 text-xs font-medium bg-[#8A3422]/10 border border-[#8A3422]/30 text-[#8A3422] mb-6">
                    @TempData["ErrorMessage"]
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script>
        lucide.createIcons();

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('sagip_theme', isDark ? 'dark' : 'light');
            syncThemeUI();
        }

        function syncThemeUI() {
            const isDark = document.documentElement.classList.contains('dark');
            const sun = document.getElementById('staff-theme-icon-sun');
            const moon = document.getElementById('staff-theme-icon-moon');
            const text = document.getElementById('staff-theme-text');

            if (sun && moon) {
                if (isDark) {
                    sun.style.transform = 'scale(0) rotate(90deg)';
                    sun.style.opacity = '0';
                    moon.style.transform = 'scale(1) rotate(0deg)';
                    moon.style.opacity = '1';
                    if (text) text.textContent = 'Light mode';
                } else {
                    sun.style.transform = 'scale(1) rotate(0deg)';
                    sun.style.opacity = '1';
                    moon.style.transform = 'scale(0) rotate(-90deg)';
                    moon.style.opacity = '0';
                    if (text) text.textContent = 'Dark mode';
                }
            }

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        document.addEventListener('DOMContentLoaded', syncThemeUI);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
